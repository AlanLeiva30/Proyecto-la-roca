<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laroca_actualizar_stock_form" model="ir.ui.view">
        <field name="name">laroca.actualizar.stock.form</field>
        <field name="model">laroca.actualizar.stock</field>
        <field name="arch" type="xml">
            <form string="Actualizar stock">
                <field name="linea_id" invisible="1"/>
                <group>
                    <group>
                        <field name="gasolinera_id" options="{'no_open': True}"/>
                        <field name="product_id" options="{'no_open': True}"/>
                        <field name="stock_actual"/>
                    </group>
                    <group>
                        <field name="cantidad_nueva" widget="laroca_contador"/>
                        <field name="diferencia" decoration-danger="diferencia &lt; 0" decoration-success="diferencia &gt; 0"/>
                        <field name="motivo"/>
                        <field name="nota" placeholder="Opcional"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirmar" type="object" string="Guardar" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
