<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laroca_importar_form" model="ir.ui.view">
        <field name="name">laroca.importar.form</field>
        <field name="model">laroca.importar</field>
        <field name="arch" type="xml">
            <form string="Importar desde Excel">
                <div invisible="resultado">
                    <p><b>1.</b> Descargá la plantilla (ya trae los datos actuales).</p>
                    <button name="action_descargar_plantilla" type="object" string="Descargar plantilla"
                            icon="fa-download" class="btn-secondary mb-3"/>
                    <p><b>2.</b> Editala en Excel y subila acá. <b>3.</b> Pulsá <b>Importar</b>.</p>
                    <group>
                        <field name="archivo" filename="nombre_archivo"/>
                        <field name="nombre_archivo" invisible="1"/>
                    </group>
                    <p class="text-muted small">Si alguna fila tiene errores no se importa nada y se indica qué corregir.</p>
                </div>
                <div invisible="not resultado" class="alert alert-success" role="alert">
                    <field name="resultado" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_importar" type="object" string="Importar" class="btn-primary"
                            icon="fa-upload" invisible="resultado"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_laroca_importar" model="ir.actions.act_window">
        <field name="name">Importar desde Excel</field>
        <field name="res_model">laroca.importar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
