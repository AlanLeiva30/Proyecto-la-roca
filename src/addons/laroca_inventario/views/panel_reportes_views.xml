<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== PANEL DEL ADMINISTRADOR (mockup 10.1) ==================== -->
    <record id="view_laroca_panel_form" model="ir.ui.view">
        <field name="name">laroca.panel.admin.form</field>
        <field name="model">laroca.panel</field>
        <field name="arch" type="xml">
            <form string="Panel del administrador" create="0" delete="0" edit="0" class="o_laroca_panel">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="o_laroca_banner o_laroca_banner_admin d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                        <div>
                            <span class="o_laroca_etiqueta"><i class="fa fa-shield me-1" title="Administrador"/>Panel del administrador</span>
                            <h2 class="mb-0 mt-1">¡Hola, <field name="nombre_usuario" class="d-inline"/>!</h2>
                            <div class="o_laroca_banner_sub">Resumen de todas las gasolineras y de la bodega central.</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button name="action_refrescar" type="object" string="Actualizar" icon="fa-refresh" class="btn-light"/>
                            <button name="action_reportes" type="object" string="Reportes" icon="fa-print" class="btn-outline-light"/>
                        </div>
                    </div>
                    <div class="row g-2 mb-4">
                        <div class="col-6 col-lg-3">
                            <button name="action_ver_pedidos" type="object" class="btn btn-primary w-100 o_laroca_acceso"
                                    icon="fa-inbox" string="Pedidos por atender"/>
                        </div>
                        <div class="col-6 col-lg-3">
                            <button name="action_preparar_entrega" type="object" class="btn btn-outline-primary w-100 o_laroca_acceso"
                                    icon="fa-truck" string="Preparar entrega"/>
                        </div>
                        <div class="col-6 col-lg-3">
                            <button name="action_ver_usuarios" type="object" class="btn btn-outline-primary w-100 o_laroca_acceso"
                                    icon="fa-users" string="Usuarios"/>
                        </div>
                        <div class="col-6 col-lg-3">
                            <button name="action_recibir_mercaderia" type="object" class="btn btn-outline-primary w-100 o_laroca_acceso"
                                    icon="fa-archive" string="Recibir mercadería"/>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-inbox fa-2x text-primary" title="Pedidos"/>
                                        <field name="kpi_pedidos" class="fs-1 fw-bold text-primary"/>
                                    </div>
                                    <div class="fw-bold mt-2">Pedidos por atender</div>
                                    <div class="text-muted small">Enviados por los encargados</div>
                                    <button name="action_ver_pedidos" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-exclamation-triangle fa-2x text-warning" title="Productos con stock bajo"/>
                                        <field name="kpi_stock_bajo" class="fs-1 fw-bold text-warning"/>
                                    </div>
                                    <div class="fw-bold mt-2">Productos con stock bajo</div>
                                    <div class="text-muted small">Bajo o crítico, en todas las gasolineras</div>
                                    <button name="action_ver_stock_bajo" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-fire fa-2x text-danger" title="Críticos"/>
                                        <field name="kpi_criticos" class="fs-1 fw-bold text-danger"/>
                                    </div>
                                    <div class="fw-bold mt-2">Críticos</div>
                                    <div class="text-muted small">Requieren atención urgente</div>
                                    <button name="action_ver_criticos" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-bell fa-2x text-warning" title="Alertas pendientes"/>
                                        <field name="kpi_alertas" class="fs-1 fw-bold text-warning"/>
                                    </div>
                                    <div class="fw-bold mt-2">Alertas pendientes</div>
                                    <div class="text-muted small">Abiertas o en proceso</div>
                                    <button name="action_ver_alertas" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-truck fa-2x text-info" title="Entregas en camino"/>
                                        <field name="kpi_en_camino" class="fs-1 fw-bold text-info"/>
                                    </div>
                                    <div class="fw-bold mt-2">Entregas en camino</div>
                                    <div class="text-muted small">Enviadas, sin confirmar</div>
                                    <button name="action_ver_en_camino" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-check-circle fa-2x text-success" title="Abastecimientos"/>
                                        <field name="kpi_abastecimientos_mes" class="fs-1 fw-bold text-success"/>
                                    </div>
                                    <div class="fw-bold mt-2">Abastecimientos</div>
                                    <div class="text-muted small">Recibidos este mes</div>
                                    <button name="action_ver_abastecimientos_mes" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-cubes fa-2x text-success" title="Unidades entregadas"/>
                                        <field name="kpi_unidades_mes" class="fs-1 fw-bold text-success"/>
                                    </div>
                                    <div class="fw-bold mt-2">Unidades entregadas</div>
                                    <div class="text-muted small">Este mes</div>
                                    <button name="action_ver_abastecimientos_mes" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-clock-o fa-2x text-secondary" title="Sin actualizar"/>
                                        <field name="kpi_sin_conteo" class="fs-1 fw-bold text-secondary"/>
                                    </div>
                                    <div class="fw-bold mt-2">Sin actualizar</div>
                                    <div class="text-muted small">Gasolineras sin conteo en 7 días</div>
                                    <button name="action_ver_sin_conteo" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="card h-100 shadow-sm border-success">
                                <div class="card-body">
                                    <div class="text-muted small"><i class="fa fa-money text-success" title="Valor"/> Valor del inventario en gasolineras</div>
                                    <field name="kpi_valor_gasolineras" class="fs-3 fw-bold text-success"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="card h-100 shadow-sm border-primary">
                                <div class="card-body">
                                    <div class="text-muted small"><i class="fa fa-archive text-primary" title="Bodega"/> Valor en bodega central</div>
                                    <field name="kpi_valor_bodega" class="fs-3 fw-bold text-primary"/>
                                    <button name="action_ver_bodega" type="object" string="Ver bodega" class="btn btn-link p-0 d-block"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="card h-100 shadow-sm border-info">
                                <div class="card-body">
                                    <div class="text-muted small"><i class="fa fa-truck text-info" title="Entregado"/> Valor entregado este mes</div>
                                    <field name="kpi_valor_mes" class="fs-3 fw-bold text-info"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="card h-100 shadow-sm border-warning">
                                <div class="card-body">
                                    <div class="text-muted small"><i class="fa fa-shopping-cart text-warning" title="Ventas"/> Vendido este mes</div>
                                    <field name="kpi_ventas_mes" class="fs-3 fw-bold text-warning"/>
                                    <button name="action_ver_ventas" type="object" string="Ver ventas" class="btn btn-link p-0 d-block"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <widget name="laroca_panel_graficos" modo="admin"/>
                    <div class="mb-4" invisible="not pedido_ids">
                        <h4><i class="fa fa-inbox text-primary" title="Pedidos"/> Pedidos por atender</h4>
                        <field name="pedido_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="fecha_envio" string="Fecha"/>
                                <field name="gasolinera_id"/>
                                <field name="solicitante_id" widget="many2one_avatar_user" string="Pedido por"/>
                                <field name="total_productos" string="Productos"/>
                                <field name="total_unidades" string="Unidades" options="{'digits': [16, 0]}"/>
                            </list>
                        </field>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-lg-7">
                            <h4><i class="fa fa-building text-primary" title="Gasolineras"/> Seguimiento de gasolineras</h4>
                            <field name="gasolinera_seguimiento_ids" readonly="1" nolabel="1"
                                   context="{'form_view_ref': 'laroca_inventario.view_laroca_gasolinera_form'}">
                                <list decoration-danger="laroca_critico_count &gt; 0"
                                      decoration-warning="laroca_critico_count == 0 and laroca_bajo_count &gt; 0">
                                    <field name="name" string="Gasolinera"/>
                                    <field name="laroca_critico_count" string="Críticos"/>
                                    <field name="laroca_bajo_count" string="Bajos"/>
                                    <field name="laroca_ultimo_conteo" string="Última actualización" optional="show"/>
                                    <field name="laroca_encargado_ids" widget="many2many_avatar_user" string="Encargado" optional="show"/>
                                </list>
                            </field>
                        </div>
                        <div class="col-12 col-lg-5">
                            <h4><i class="fa fa-bell text-warning" title="Alertas"/> Alertas recientes</h4>
                            <field name="alerta_reciente_ids" readonly="1" nolabel="1" invisible="not alerta_reciente_ids">
                                <list decoration-danger="nivel == 'critico'" decoration-warning="nivel == 'bajo'">
                                    <field name="product_id" string="Producto"/>
                                    <field name="gasolinera_id" string="Gasolinera"/>
                                    <field name="nivel" widget="badge"
                                           decoration-danger="nivel == 'critico'" decoration-warning="nivel == 'bajo'"/>
                                </list>
                            </field>
                            <div class="text-muted small" invisible="alerta_reciente_ids"><i class="fa fa-check-circle text-success" title="Sin alertas"/> No hay alertas pendientes.</div>
                        </div>
                    </div>
                    <h4><i class="fa fa-truck text-info" title="Entregas"/> Entregas en camino</h4>
                    <field name="entrega_en_camino_ids" readonly="1" nolabel="1" invisible="not entrega_en_camino_ids">
                        <list>
                            <field name="name"/>
                            <field name="gasolinera_id"/>
                            <field name="fecha_programada" string="Fecha"/>
                            <field name="total_unidades" string="Unidades" options="{'digits': [16, 0]}"/>
                            <button name="action_marcar_entregada" type="object" string="Entregado ✓" class="btn-success btn-sm"
                                    confirm="¿Llegó todo lo enviado? La entrega queda como entregada y se suma al inventario de la gasolinera."/>
                        </list>
                    </field>
                    <div class="text-muted small" invisible="entrega_en_camino_ids">No hay entregas en camino.</div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== PANEL DEL ENCARGADO ("Mi gasolinera") ==================== -->
    <record id="view_laroca_panel_encargado_form" model="ir.ui.view">
        <field name="name">laroca.panel.encargado.form</field>
        <field name="model">laroca.panel</field>
        <field name="arch" type="xml">
            <form string="Mi gasolinera" create="0" delete="0" edit="0" class="o_laroca_panel">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="o_laroca_banner o_laroca_banner_encargado d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                        <div>
                            <span class="o_laroca_etiqueta"><i class="fa fa-map-marker me-1" title="Gasolinera"/><field name="nombre_gasolineras" class="d-inline"/></span>
                            <h2 class="mb-0 mt-1">¡Hola, <field name="nombre_usuario" class="d-inline"/>!</h2>
                            <div class="o_laroca_banner_sub" invisible="not ultimo_conteo">
                                Última actualización del inventario: <field name="ultimo_conteo" class="d-inline"/>
                            </div>
                            <div class="o_laroca_banner_sub" invisible="ultimo_conteo">
                                Todavía no se registró ningún conteo. ¡Empezá con "Hacer un conteo"!
                            </div>
                        </div>
                        <button name="action_refrescar" type="object" string="Actualizar" icon="fa-refresh" class="btn-light"/>
                    </div>
                    <h4 class="mb-2">¿Qué querés hacer?</h4>
                    <div class="row g-2 mb-4">
                        <div class="col-6 col-lg-3">
                            <button name="action_vender" type="object" class="btn btn-success w-100 o_laroca_acceso o_laroca_acceso_grande"
                                    icon="fa-shopping-cart" string="Vender"/>
                        </div>
                        <div class="col-6 col-lg-3">
                            <button name="action_pedir" type="object" class="btn btn-primary w-100 o_laroca_acceso o_laroca_acceso_grande"
                                    icon="fa-paper-plane" string="Pedir productos"/>
                        </div>
                        <div class="col-6 col-lg-3">
                            <button name="action_ver_en_camino" type="object" class="btn btn-outline-primary w-100 o_laroca_acceso o_laroca_acceso_grande"
                                    icon="fa-truck" string="Recibir entregas"/>
                        </div>
                        <div class="col-6 col-lg-3">
                            <button name="action_ver_inventario" type="object" class="btn btn-outline-primary w-100 o_laroca_acceso o_laroca_acceso_grande"
                                    icon="fa-cubes" string="Ver mi inventario"/>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-4 mt-n2">
                        <button name="action_ver_pedidos" type="object" string="Mis pedidos" icon="fa-inbox" class="btn-light"/>
                        <button name="action_ver_ventas" type="object" string="Mis ventas" icon="fa-list" class="btn-light"/>
                        <button name="action_ver_alertas" type="object" string="Mis alertas" icon="fa-bell" class="btn-light"/>
                    </div>
                    <h4 class="mb-2">Así está tu inventario</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm o_laroca_tarjeta o_laroca_suficiente">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-check-circle fa-2x text-success" title="Suficiente"/>
                                        <field name="kpi_suficientes" class="fs-1 fw-bold text-success"/>
                                    </div>
                                    <div class="fw-bold mt-2">Suficiente</div>
                                    <div class="text-muted small">Productos bien abastecidos</div>
                                    <button name="action_ver_suficientes" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm o_laroca_tarjeta o_laroca_bajo">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-exclamation-triangle fa-2x text-warning" title="Bajo"/>
                                        <field name="kpi_bajos" class="fs-1 fw-bold text-warning"/>
                                    </div>
                                    <div class="fw-bold mt-2">Bajo</div>
                                    <div class="text-muted small">Debajo del mínimo</div>
                                    <button name="action_ver_bajos" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm o_laroca_tarjeta o_laroca_critico">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-fire fa-2x text-danger" title="Crítico"/>
                                        <field name="kpi_criticos" class="fs-1 fw-bold text-danger"/>
                                    </div>
                                    <div class="fw-bold mt-2">Crítico</div>
                                    <div class="text-muted small">Casi agotados</div>
                                    <button name="action_ver_criticos" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 shadow-sm o_laroca_tarjeta">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <i class="fa fa-shopping-cart fa-2x text-success" title="Vendido hoy"/>
                                        <field name="kpi_ventas_hoy" class="fs-3 fw-bold text-success"/>
                                    </div>
                                    <div class="fw-bold mt-2">Vendido hoy</div>
                                    <div class="text-muted small"><field name="kpi_unidades_vendidas_hoy" class="d-inline"/> unidades</div>
                                    <button name="action_ver_ventas_hoy" type="object" string="Ver" class="btn btn-link p-0 mt-1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-lg-7">
                            <h4><i class="fa fa-exclamation-circle text-danger" title="Pendientes"/> Productos que se están acabando</h4>
                            <field name="producto_pendiente_ids" readonly="1" nolabel="1" invisible="not producto_pendiente_ids">
                                <list decoration-danger="estado == 'critico'" decoration-warning="estado == 'bajo'">
                                    <field name="image_128" widget="image" options="{'size': [32, 32]}" string=" "/>
                                    <field name="product_id" string="Producto"/>
                                    <field name="gasolinera_id" string="Gasolinera" optional="hide"/>
                                    <field name="stock_actual" string="Hay" options="{'digits': [16, 0]}"/>
                                    <field name="stock_minimo" string="Mínimo" options="{'digits': [16, 0]}"/>
                                    <field name="estado" widget="badge"
                                           decoration-warning="estado == 'bajo'" decoration-danger="estado == 'critico'"/>
                                </list>
                            </field>
                            <div class="alert alert-success mb-0" role="status" invisible="producto_pendiente_ids">
                                <i class="fa fa-check-circle me-1" title="Todo bien"/>¡Todo bien! Ningún producto está por acabarse.
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2" invisible="not producto_pendiente_ids">
                                <button name="action_pedir_faltantes" type="object" string="Pedir estos productos"
                                        icon="fa-paper-plane" class="btn-primary"/>
                                <span class="text-muted small">El administrador ya recibió la alerta; con un pedido le decís cuánto necesitás.</span>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <h4><i class="fa fa-truck text-info" title="Entregas"/> Entregas por recibir</h4>
                            <field name="entrega_en_camino_ids" readonly="1" nolabel="1" invisible="not entrega_en_camino_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="gasolinera_id" optional="hide"/>
                                    <field name="fecha_programada" string="Fecha"/>
                                    <field name="total_unidades" string="Unidades" options="{'digits': [16, 0]}"/>
                                    <button name="action_marcar_entregada" type="object" string="Entregado ✓" class="btn-success btn-sm"
                                            confirm="¿Llegó todo lo enviado? La entrega queda como entregada y se suma a tu inventario."/>
                                </list>
                            </field>
                            <div class="text-muted small" invisible="entrega_en_camino_ids">No tenés entregas en camino.</div>
                            <div class="text-muted small mt-1" invisible="not entrega_en_camino_ids">
                                Cuando llegue, tocá <b>Entregado ✓</b>. Si faltó algo, abrí la entrega y usá <b>Llegó distinto</b>.
                            </div>
                            <h4 class="mt-4"><i class="fa fa-inbox text-primary" title="Pedidos"/> Mis pedidos</h4>
                            <field name="pedido_ids" readonly="1" nolabel="1" invisible="not pedido_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="fecha_envio" string="Fecha" optional="hide"/>
                                    <field name="total_unidades" string="Unidades" options="{'digits': [16, 0]}"/>
                                    <field name="estado" widget="badge" decoration-info="estado == 'enviado'"
                                           decoration-warning="estado in ('aprobado', 'en_camino')"/>
                                </list>
                            </field>
                            <div class="text-muted small" invisible="pedido_ids">No tenés pedidos en curso.</div>
                        </div>
                    </div>
                    <widget name="laroca_panel_graficos" modo="encargado"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_laroca_panel" model="ir.actions.server">
        <field name="name">Panel</field>
        <field name="model_id" ref="model_laroca_panel"/>
        <field name="state">code</field>
        <field name="code">action = model.action_abrir_panel()</field>
        <field name="groups_id" eval="[(4, ref('group_laroca_encargado'))]"/>
    </record>

    <!-- ==================== ASISTENTE DE REPORTES ==================== -->
    <record id="view_laroca_reporte_form" model="ir.ui.view">
        <field name="name">laroca.reporte.form</field>
        <field name="model">laroca.reporte</field>
        <field name="arch" type="xml">
            <form string="Reportes">
                <group>
                    <field name="tipo" widget="radio"/>
                    <field name="gasolinera_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="Todas"/>
                    <field name="fecha_desde" invisible="tipo != 'abastecimientos'" required="tipo == 'abastecimientos'"/>
                    <field name="fecha_hasta" invisible="tipo != 'abastecimientos'" required="tipo == 'abastecimientos'"/>
                </group>
                <div class="text-muted small">
                    Los reportes se generan en PDF. Para Excel, usá cualquier lista →
                    seleccionar registros → Acciones → Exportar.
                </div>
                <footer>
                    <button name="action_imprimir" type="object" string="Generar PDF" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_laroca_reporte_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir reportes</field>
        <field name="res_model">laroca.reporte</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ==================== ANÁLISIS (gráficos y tablas dinámicas) ==================== -->
    <record id="view_laroca_inventario_graph" model="ir.ui.view">
        <field name="name">laroca.inventario.graph</field>
        <field name="model">laroca.inventario</field>
        <field name="arch" type="xml">
            <graph string="Estado del inventario" type="bar" stacked="1">
                <field name="gasolinera_id"/>
                <field name="estado"/>
            </graph>
        </field>
    </record>

    <record id="view_laroca_inventario_pivot" model="ir.ui.view">
        <field name="name">laroca.inventario.pivot</field>
        <field name="model">laroca.inventario</field>
        <field name="arch" type="xml">
            <pivot string="Inventario por gasolinera">
                <field name="gasolinera_id" type="row"/>
                <field name="estado" type="col"/>
                <field name="stock_actual" type="measure"/>
                <field name="valor_stock" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_laroca_analisis_inventario" model="ir.actions.act_window">
        <field name="name">Análisis de inventario</field>
        <field name="res_model">laroca.inventario</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_laroca_inventario_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_laroca_inventario_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_laroca_inventario_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_laroca_inventario_list')})]"/>
    </record>

    <record id="view_laroca_entrega_linea_graph" model="ir.ui.view">
        <field name="name">laroca.entrega.linea.graph</field>
        <field name="model">laroca.entrega.linea</field>
        <field name="arch" type="xml">
            <graph string="Abastecimientos por mes" type="bar" stacked="1">
                <field name="fecha_entrega" interval="month"/>
                <field name="gasolinera_id"/>
                <field name="cantidad_entregada" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_laroca_analisis_abastecimientos" model="ir.actions.act_window">
        <field name="name">Análisis de abastecimientos</field>
        <field name="res_model">laroca.entrega.linea</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('estado', '=', 'entregada')]</field>
        <field name="search_view_id" ref="view_laroca_entrega_linea_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_laroca_entrega_linea_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_laroca_entrega_linea_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_laroca_entrega_linea_list')})]"/>
    </record>

    <record id="view_laroca_alerta_graph" model="ir.ui.view">
        <field name="name">laroca.alerta.graph</field>
        <field name="model">laroca.alerta</field>
        <field name="arch" type="xml">
            <graph string="Alertas" type="bar" stacked="1">
                <field name="gasolinera_id"/>
                <field name="nivel"/>
            </graph>
        </field>
    </record>

    <record id="view_laroca_alerta_pivot" model="ir.ui.view">
        <field name="name">laroca.alerta.pivot</field>
        <field name="model">laroca.alerta</field>
        <field name="arch" type="xml">
            <pivot string="Alertas">
                <field name="product_id" type="row"/>
                <field name="gasolinera_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_laroca_analisis_alertas" model="ir.actions.act_window">
        <field name="name">Análisis de alertas</field>
        <field name="res_model">laroca.alerta</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_laroca_alerta_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_laroca_alerta_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_laroca_alerta_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_laroca_alerta_list')})]"/>
    </record>
</odoo>
