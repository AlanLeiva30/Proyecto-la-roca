<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Roles del sistema (aparecen en el formulario de usuario como
         "La Roca: Encargado de sucursal / Administrador")
         ============================================================ -->
    <record id="module_category_laroca" model="ir.module.category">
        <field name="name">La Roca</field>
        <field name="description">Roles del sistema de inventario y abastecimiento.</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_laroca_encargado" model="res.groups">
        <field name="name">Encargado de sucursal</field>
        <field name="category_id" ref="module_category_laroca"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Ve y actualiza solo el inventario de las gasolineras que tiene asignadas.</field>
    </record>

    <record id="group_laroca_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_laroca"/>
        <field name="implied_ids" eval="[(4, ref('group_laroca_encargado')), (4, ref('stock.group_stock_manager')), (4, ref('base.group_erp_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Ve todas las gasolineras, administra el catálogo, las gasolineras y los usuarios.</field>
    </record>

    <!-- ============================================================
         Reglas de registro (ir.rule)
         Odoo combina con OR las reglas de grupo: el encargado solo ve
         sus gasolineras; el administrador tiene una regla "todo" que
         amplía el acceso.
         ============================================================ -->

    <record id="rule_inventario_encargado" model="ir.rule">
        <field name="name">La Roca: Inventario por gasolinera - solo gasolineras asignadas</field>
        <field name="model_id" ref="model_laroca_inventario"/>
        <field name="groups" eval="[(4, ref('group_laroca_encargado'))]"/>
        <field name="domain_force">[('gasolinera_id', 'in', user.laroca_gasolinera_ids.ids)]</field>
    </record>
    <record id="rule_inventario_admin" model="ir.rule">
        <field name="name">La Roca: Inventario por gasolinera - administrador ve todo</field>
        <field name="model_id" ref="model_laroca_inventario"/>
        <field name="groups" eval="[(4, ref('group_laroca_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_warehouse_encargado" model="ir.rule">
        <field name="name">La Roca: Gasolineras (almacenes) - solo gasolineras asignadas</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="groups" eval="[(4, ref('group_laroca_encargado'))]"/>
        <field name="domain_force">[('id', 'in', user.laroca_gasolinera_ids.ids)]</field>
    </record>
    <record id="rule_warehouse_admin" model="ir.rule">
        <field name="name">La Roca: Gasolineras (almacenes) - administrador ve todo</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
