    <record id="rule_location_encargado" model="ir.rule">
        <field name="name">La Roca: Ubicaciones - solo gasolineras asignadas</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="groups" eval="[(4, ref('group_laroca_encargado'))]"/>
        <field name="domain_force">['|', ('warehouse_id', '=', False), ('warehouse_id', 'in', user.laroca_gasolinera_ids.ids)]</field>
    </record>
    <record id="rule_location_admin" model="ir.rule">
        <field name="name">La Roca: Ubicaciones - administrador ve todo</field>
        <field name="model_id" ref="stock.model_stock_location"/>
