        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="groups" eval="[(4, ref('group_laroca_encargado'))]"/>
        <field name="domain_force">['|', ('location_id.usage', 'not in', ('internal', 'transit')), ('location_id.warehouse_id', 'in', user.laroca_gasolinera_ids.ids)]</field>
    </record>
    <record id="rule_quant_admin" model="ir.rule">
